---
// Las escenas de «Novedades»: recreaciones en HTML, con pingüinos y en el idioma de la página. Sólo CSS.
// Todo se mide en em y el em sale del ancho del panel (container query), así que escalan enteras.
import Blob from "../Blob.astro";

interface Props { kind: string; lang: string; }
const { kind, lang } = Astro.props;
const es = lang !== "en";
const team = [
  { name: "Tomás", blob: "cobalto", role: es ? "Desarrollo" : "Developer", text: es ? "Arregla la tienda y prueba cada cambio." : "Fixes the store and tests every change." },
  { name: "Marta", blob: "brasa", role: es ? "Atención al cliente" : "Customer desk", text: es ? "Contesta por WhatsApp y sólo te avisa si hace falta." : "Answers on WhatsApp and only pings you when needed." },
  { name: "Vera", blob: "amatista", role: "Marketing", text: es ? "Escribe las campañas y las programa." : "Writes the campaigns and schedules them." },
] as const;
const steps = es
  ? [["Validar la oferta", "Vera"], ["Preparar el anuncio", "Lucía"], ["Planificar la primera entrega", "Tomás"]]
  : [["Validate the offer", "Vera"], ["Draft the announcement", "Lucía"], ["Plan the first delivery", "Tomás"]];
const bars = [38, 52, 44, 68, 60, 82, 94];
const days = es ? ["L", "M", "X", "J", "V", "S", "D"] : ["M", "T", "W", "T", "F", "S", "S"];
const chats = es
  ? [["Telegram", "¿Sigue en pie lo del jueves?", "#2aabee"], ["WhatsApp", "Pedido 1042: ya está en camino.", "#25d366"], ["Discord", "Lista la nota de la versión.", "#5865f2"], ["Slack", "Informe semanal enviado.", "#e01e5a"]]
  : [["Telegram", "Is Thursday still on?", "#2aabee"], ["WhatsApp", "Order 1042 is on its way.", "#25d366"], ["Discord", "Release note is ready.", "#5865f2"], ["Slack", "Weekly report sent.", "#e01e5a"]];
---
<div class="fs" aria-hidden="true">
  {kind === "team" && (
    <div class="fs__team">
      <div class="fs__card fs__card--lead"><p><Blob name="coral" size="2.4em" /><b>Lucía</b></p><small>{es ? "Dirección de producto" : "Product manager"}</small><span>{es ? "Reparte el trabajo y lo sigue hasta cerrarlo." : "Hands out the work and follows it to the end."}</span></div>
      <svg class="fs__lines" viewBox="0 0 100 10" preserveAspectRatio="none"><path d="M50 0C50 6 16 4 16 10M50 0V10M50 0C50 6 84 4 84 10" /></svg>
      <div class="fs__row">{team.map((a, i) => <div class="fs__card" style={`--d:${0.25 + i * 0.2}s`}><p><Blob name={a.blob} size="2.4em" /><b>{a.name}</b></p><small>{a.role}</small><span>{a.text}</span></div>)}</div>
      <div class="fs__pass"><Blob name="coral" size="1.5em" />→<Blob name="cobalto" size="1.5em" /><span>{es ? "Lucía le pasó la tarea a Tomás" : "Lucía handed the task to Tomás"}</span></div>
    </div>
  )}
  {kind === "crew-demo" && (
    <div class="fs__browser">
      <div class="fs__url"><i></i><span>tienda.example.com/admin/{es ? "pedidos" : "orders"}</span></div>
      <div class="fs__page">
        <strong>{es ? "Pedidos de la semana" : "This week's orders"}</strong>
        {["#1042", "#1043", "#1044", "#1045"].map((o, i) => <div class="fs__order" style={`--d:${0.4 + i * 0.7}s`}><span>{o}</span><u></u><em>{es ? "Revisado" : "Checked"}</em></div>)}
        <i class="fs__cursor"></i>
      </div>
      <div class="fs__status"><Blob name="cobalto" size="1.7em" /><span><b>Tomás</b> {es ? "está leyendo los pedidos" : "is reading the orders"}</span><mark>{es ? "Hay que iniciar sesión: te toca" : "Sign-in needed: your turn"}</mark></div>
    </div>
  )}
  {kind === "app-widget" && (
    <div class="fs__widget">
      <small>{es ? "Tienda Acme · Ventas" : "Acme Store · Sales"}</small>
      <strong>{es ? "Ventas de esta semana" : "Sales this week"}</strong>
      <div class="fs__stats"><p><b>{es ? "1.284 €" : "€1,284"}</b>{es ? "Hoy" : "Today"}</p><p><b>38</b>{es ? "Pedidos" : "Orders"}</p><p><b>+12 %</b>{es ? "Frente a ayer" : "Versus yesterday"}</p></div>
      <div class="fs__bars">{bars.map((h, i) => <div><i style={`height:${h}%;--d:${i * 0.09}s`}></i><span>{days[i]}</span></div>)}</div>
      <ul>{steps.map(([t, who], i) => <li style={`--d:${0.7 + i * 0.25}s`}><span>{t}</span><em>{who}</em></li>)}</ul>
    </div>
  )}
  {kind === "inbox" && (
    <div class="fs__inbox">
      <strong>{es ? "Bandeja" : "Inbox"}</strong>
      {chats.map(([ch, text, color], i) => <div class="fs__chat" style={`--d:${0.2 + i * 0.55}s`}><i style={`background:${color}`}></i><p><b>{ch}</b><span>{text}</span></p><small>{`9:${12 + i * 7}`}</small></div>)}
      <div class="fs__reply"><Blob name="menta" size="1.7em" /><span>{es ? "Nova contesta con la misma memoria en todos los canales." : "Nova replies with the same memory on every channel."}</span></div>
    </div>
  )}
</div>

<style>
  .fs { container-type: size; position: absolute; inset: 0; color: var(--colonia-fg); font-family: var(--colonia-font-sans); }
  .fs > div { box-sizing: border-box; display: flex; flex-direction: column; height: 100cqh; padding: 4.5cqw; gap: 2.4cqw; font-size: max(2.1cqw, 9px); line-height: 1.35; }
  .fs strong { font-size: 1.5em; }
  .fs small { color: var(--colonia-fg-subtle); }
  .fs p { margin: 0; }
  .fs__card, .fs__chat, .fs__order, .fs li { animation: fs-in .5s var(--colonia-spring) both; animation-delay: var(--d, 0s); }
  .fs > .fs__team { align-items: center; justify-content: center; gap: 0; }
  .fs__card { flex: 1; display: flex; flex-direction: column; gap: .4em; min-width: 0; padding: .9em; border: 1px solid var(--colonia-border-strong); border-radius: .9em; background: var(--colonia-fill); }
  .fs__card p { display: flex; align-items: center; gap: .5em; }
  .fs__card span { color: var(--colonia-fg-muted); font-size: .92em; }
  .fs__card--lead { flex: none; width: 42%; }
  .fs__lines { width: 80%; height: 2.4em; }
  .fs__lines path { fill: none; stroke: var(--colonia-border-strong); stroke-dasharray: 2 2; vector-effect: non-scaling-stroke; }
  .fs__row { display: flex; gap: .9em; width: 100%; }
  .fs__pass { display: flex; align-items: center; gap: .4em; margin-top: 1.2em; padding: .35em .9em; border-radius: 99px; background: var(--colonia-brand-soft); color: var(--colonia-brand-soft-fg); font-size: .92em; animation: fs-in .5s 1.1s both; }
  .fs__url { display: flex; align-items: center; gap: .6em; padding: .55em .9em; border-radius: .7em; background: var(--colonia-fill); color: var(--colonia-fg-muted); font-family: var(--colonia-font-mono); font-size: .9em; }
  .fs__url i { width: .7em; height: .7em; border-radius: 50%; background: #e8a33d; }
  .fs__page { position: relative; flex: 1; display: flex; flex-direction: column; gap: .55em; padding: 1em; border: 1px solid var(--colonia-border); border-radius: .9em; }
  .fs__order { display: flex; align-items: center; gap: .8em; padding: .4em 0; border-bottom: 1px solid var(--colonia-border); }
  .fs__order u { flex: 1; height: .5em; border-radius: 9px; background: var(--colonia-fill-strong); }
  .fs__order em { color: var(--colonia-brand-soft-fg); font-style: normal; font-size: .9em; }
  .fs__cursor { position: absolute; left: 70%; top: 30%; width: 1em; height: 1em; border-radius: 50%; background: var(--colonia-brand-soft-fg); opacity: .75; animation: fs-cursor 4s ease-in-out infinite; }
  .fs__status { display: flex; flex-wrap: wrap; align-items: center; gap: .6em; }
  .fs__status mark { padding: .2em .7em; border-radius: 99px; background: rgb(232 163 61 / .18); color: #d98e22; font-size: .9em; }
  .fs__stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: .7em; }
  .fs__stats p { display: flex; flex-direction: column; padding: .6em .8em; border-radius: .7em; background: var(--colonia-fill); color: var(--colonia-fg-muted); font-size: .9em; }
  .fs__stats b { color: var(--colonia-fg); font-size: 1.4em; }
  .fs__bars { flex: 1; min-height: 0; display: grid; grid-template-columns: repeat(7, 1fr); gap: .7em; }
  .fs__bars div { display: flex; flex-direction: column; justify-content: flex-end; gap: .2em; min-height: 0; color: var(--colonia-fg-subtle); font-size: .85em; text-align: center; }
  .fs__bars i { display: block; border-radius: .35em .35em 0 0; background: var(--colonia-brand); transform-origin: bottom; animation: fs-grow .7s var(--colonia-ease) both; animation-delay: var(--d); }
  .fs ul { margin: 0; padding: 0; list-style: none; }
  .fs li { display: flex; justify-content: space-between; padding: .25em 0; border-top: 1px solid var(--colonia-border); }
  .fs li em { color: var(--colonia-fg-subtle); font-style: normal; }
  .fs__chat { display: flex; align-items: center; gap: .8em; padding: .65em .8em; border-radius: .8em; background: var(--colonia-fill); }
  .fs__chat i { flex: none; width: 1.1em; height: 1.1em; border-radius: 50%; }
  .fs__chat p { flex: 1; min-width: 0; display: flex; flex-direction: column; }
  .fs__chat span { overflow: hidden; color: var(--colonia-fg-muted); text-overflow: ellipsis; white-space: nowrap; }
  .fs__reply { display: flex; align-items: center; gap: .6em; margin-top: auto; color: var(--colonia-fg-muted); animation: fs-in .5s 2.5s both; }
  @container (max-width: 420px) { .fs__chat:nth-of-type(n+4), .fs__reply { display: none; } .fs__row .fs__card span, .fs ul, .fs__status mark, .fs__card--lead span { display: none; } .fs__card--lead { width: 60%; } }
  @keyframes fs-in { from { opacity: 0; transform: translateY(.6em); } }
  @keyframes fs-grow { from { transform: scaleY(0); } }
  @keyframes fs-cursor { 0%, 100% { left: 70%; top: 30%; } 35% { left: 84%; top: 52%; } 70% { left: 40%; top: 76%; } }
  @media (prefers-reduced-motion: reduce) { .fs * { animation: none !important; } }
</style>
