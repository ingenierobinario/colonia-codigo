---
import blobs from "../../data/blobs.json";
import { HIDDEN_SECTIONS, RESERVAR_URL, sectionRoute, type SectionId } from "../../config/site";
import { sitePath } from "../../doc-routes.mjs";
import { HOME, type Lang } from "../../i18n/home";
import Blob from "../Blob.astro";
import UiIcon from "../UiIcon.astro";
import "./web.css";

interface Props {
  lang: Lang;
  section?: SectionId;
}
const { lang, section } = Astro.props;
const t = HOME[lang];
const pre = lang === "es" ? "/es" : "";
const href = (path: string) => sitePath(path, import.meta.env.BASE_URL);
const page = (id?: SectionId) => href(sectionRoute(lang, id));
type BlobName = keyof typeof blobs;
// Product: the home's sections, reachable from any page.
const sections: [string, string, BlobName][] = [
  ["what", t.nav.sectionsLabel.what, "menta"],
  ["new", t.nav.sectionsLabel.new, "cobalto"],
  ["start", t.nav.sectionsLabel.start, "coral"],
  ["map", t.nav.sectionsLabel.map, "orbita"],
  ["terminal", t.nav.sectionsLabel.terminal, "noche"],
  ["questions", t.nav.sectionsLabel.questions, "ovni"],
  ["compare", t.nav.sectionsLabel.compare, "amatista"],
  ["download", t.nav.sectionsLabel.download, "aqua"],
];
---
<script is:inline>
  (() => {
    let theme = "";
    try { theme = localStorage.getItem("starlight-theme") || ""; } catch {}
    const root = document.documentElement;
    root.dataset.theme = theme === "light" || theme === "dark" ? theme : matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
    root.classList.add("js");
  })();
</script>
<nav class="web-header" id="nav" aria-label={t.nav.main}>
  <div class="wrap nav__in">
    <a class="brand" href={page()}><Blob name="menta" size={26} /><span>Colonia</span></a>
    <div class="nav__links" id="navLinks">
      <div class="nav__drop nav__product">
        <a class="nav__drop-link" href={page("what")}>{t.nav.product}<svg width="10" height="10" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M2 3.5 5 6.5 8 3.5" /></svg></a>
        <div class="nav__menu nav__menu--start">
          <div class="nav__menu-card">
            <ul class="nav__menu-sections">
              {sections.filter(([id]) => !HIDDEN_SECTIONS.includes(id as SectionId)).map(([id, label, blob]) => (
                <li><a href={page(id as SectionId)} data-section={id} aria-current={section === id ? "page" : undefined}><Blob name={blob} size={22} /><span>{label}</span></a></li>
              ))}
            </ul>
            <p class="nav__menu-foot"><span>{t.nav.productNote}</span><a href={RESERVAR_URL}>{t.reserve} →</a></p>
          </div>
        </div>
      </div>
      <a href={page("questions")} aria-current={section === "questions" ? "page" : undefined}>{t.nav.questions}</a>
      <a class="nav__sheet-get" href={RESERVAR_URL}>{t.reserve}</a>
    </div>
    <div class="nav__cta">
      <div class="lang" role="group" aria-label={t.langLabel}>
        <a href={href(sectionRoute("en", section))} class:list={{ on: lang === "en" }} hreflang="en" lang="en">EN</a>
        <a href={href(sectionRoute("es", section))} class:list={{ on: lang === "es" }} hreflang="es" lang="es">ES</a>
      </div>
      <button class="icon-btn" id="theme" type="button" aria-label={t.themeLabel} title={t.themeLabel}>
        <UiIcon name="sun" class="sun" /><UiIcon name="moon" class="moon" />
      </button>
      <a class="btn btn-light nav__get" href={RESERVAR_URL}><span class="lbl">{t.reserve}</span></a>
      <button class="icon-btn nav__toggle" type="button" aria-label={t.nav.menu} aria-expanded="false" aria-controls="navLinks"><span></span><span></span></button>
    </div>
  </div>
</nav>
<script>
  const nav = document.getElementById("nav");
  const toggle = nav?.querySelector<HTMLButtonElement>(".nav__toggle");
  const open = (on: boolean) => {
    nav?.toggleAttribute("data-open", on);
    toggle?.setAttribute("aria-expanded", String(on));
  };
  toggle?.addEventListener("click", () => open(!nav?.hasAttribute("data-open")));
  for (const link of nav?.querySelectorAll(".nav__links a") ?? []) link.addEventListener("click", () => open(false));
  addEventListener("keydown", (e) => {
    if (e.key === "Escape" && nav?.hasAttribute("data-open")) {
      open(false);
      toggle?.focus();
    }
  });
  // A menu closes once one of its links is chosen, until the pointer leaves it.
  for (const drop of nav?.querySelectorAll<HTMLElement>(".nav__drop") ?? []) {
    drop.querySelector(".nav__menu")?.addEventListener("click", (e) => {
      if (!(e.target as Element).closest("a")) return;
      drop.classList.add("is-dismissed");
      (document.activeElement as HTMLElement | null)?.blur();
    });
    drop.addEventListener("pointerleave", () => drop.classList.remove("is-dismissed"));
  }
  // On the home, Product marks the section in view.
  const marks = [...(nav?.querySelectorAll<HTMLAnchorElement>("a[data-section]") ?? [])];
  const homeSections = marks.map((a) => document.getElementById(a.dataset.section ?? "")).filter((el): el is HTMLElement => Boolean(el));
  if (homeSections.length) {
    const inView = new Set<string>();
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) inView.add(e.target.id);
          else inView.delete(e.target.id);
        }
        const current = homeSections.find((el) => inView.has(el.id))?.id;
        for (const a of marks) {
          if (a.dataset.section === current) a.setAttribute("aria-current", "location");
          else a.removeAttribute("aria-current");
        }
      },
      { rootMargin: "-45% 0px -50% 0px" },
    );
    for (const el of homeSections) io.observe(el);
  }
  // At the very top the header is a fade over the page; once the page moves it becomes a bar.
  const onScroll = () => nav?.toggleAttribute("data-scrolled", scrollY > 24);
  addEventListener("scroll", onScroll, { passive: true });
  onScroll();
  document.getElementById("theme")?.addEventListener("click", () => {
    const next = document.documentElement.dataset.theme === "light" ? "dark" : "light";
    document.documentElement.dataset.theme = next;
    try { localStorage.setItem("starlight-theme", next); } catch {}
  });
</script>
