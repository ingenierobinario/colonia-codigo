---
import { RESERVAR_URL, sectionRoute } from "../../config/site";
import { sitePath } from "../../doc-routes.mjs";
import { HOME, type Lang } from "../../i18n/home";
import Blob from "../Blob.astro";
import OsIcon from "../OsIcon.astro";
import "./web.css";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const all = HOME[lang];
const t = all.footer;
const pre = lang === "es" ? "/es" : "";
const href = (path: string) => sitePath(path, import.meta.env.BASE_URL);
const page = (id?: Parameters<typeof sectionRoute>[1]) => href(sectionRoute(lang, id));
type Group = { title: string; links: (readonly [string, string])[] };
const labels = all.nav.sectionsLabel;
const product: Group = {
  title: t.product,
  links: [
    [labels.what, page("what")],
    [labels.new, page("new")],
    [labels.start, page("start")],
    [all.reserve, RESERVAR_URL],
  ],
};
const more: Group = {
  title: t.more,
  links: [
    [labels.terminal, page("terminal")],
    [labels.questions, page("questions")],
  ],
};
const platforms = [
  { name: "mac", label: "macOS" },
  { name: "windows", label: "Windows" },
  { name: "linux", label: "Linux" },
] as const;
const front = ["coral", "cobalto", "menta", "amatista", "brasa"] as const;
const back = ["orbita", "perla", "caracol", "kiwi"] as const;
---
<footer class="web-footer">
  <div class="wrap">
    <div class="web-footer__top">
      <div class="web-footer__intro">
        <a class="brand" href={page()}><Blob name="menta" size={26} />Colonia</a>
        <p class="web-footer__description">{t.description}</p>
        <p class="web-footer__home"><Blob name="menta" size={20} /><b>Home</b>{t.home}</p>
        <div class="web-footer__legal">
          <p>© 2026 Ingeniero Binario</p>
          <p class="web-footer__fine">{t.trademarks}</p>
        </div>
      </div>
      <div class="web-footer__row web-footer__row--site">
        {[product, more].map((group) => (
          <div class="web-footer__col"><nav aria-label={group.title}><h2>{group.title}</h2><ul>{group.links.map(([label, url]) => <li><a href={url}>{label}</a></li>)}</ul></nav></div>
        ))}
      </div>
      <div class="web-footer__bar">
        <div class="web-footer__availability">
          <p class="web-footer__available">{t.availableFor}</p>
          <ul class="web-footer__platforms" aria-label={t.platforms}>{platforms.map(({ name, label }) => <li><OsIcon name={name} size={13} />{label}</li>)}</ul>
        </div>
      </div>
    </div>
  </div>
  <div class="wrap web-footer__mark" aria-hidden="true">
    <div class="web-footer__wordmark"><span>Colonia</span></div>
    <div class="web-footer__back">{back.map((name) => <Blob name={name} size="clamp(20px, 2.6vw, 26px)" />)}</div>
    <div class="web-footer__front">{front.map((name) => <Blob name={name} size="clamp(34px, 5vw, 52px)" />)}</div>
  </div>
</footer>
<a
  class="wa-bubble"
  href={`https://wa.me/376665898?text=${encodeURIComponent(all.whatsappText)}`}
  target="_blank"
  rel="noopener"
  aria-label={all.whatsappLabel}
  title={all.whatsappLabel}
>
  <svg viewBox="0 0 24 24" width="30" height="30" fill="currentColor" aria-hidden="true"><path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.16-.17.2-.35.22-.65.08-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.61-.91-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.21 3.07c.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.63.71.23 1.36.2 1.87.12.57-.09 1.76-.72 2-1.41.25-.7.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35zM12.05 21.5h-.01a9.5 9.5 0 0 1-4.84-1.33l-.35-.21-3.6.95.96-3.51-.23-.36a9.5 9.5 0 1 1 8.07 4.46zM20.13 3.9A11.4 11.4 0 0 0 2.2 17.64L.6 23.5l6-1.57a11.4 11.4 0 0 0 5.44 1.39h.01A11.4 11.4 0 0 0 20.13 3.9z"/></svg>
</a>
