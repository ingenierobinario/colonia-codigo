---
import { getImage, Image } from "astro:assets";
// A screenshot of the real app in a window (or phone) frame, in the theme the reader is looking at: <name>.webp is the
// light capture and <name>-dark.webp the dark one, both taken by scripts/shots.ts against a demo core (Spanish: below). `split` shows
// both at once, cut on a diagonal. A missing capture shows a dashed box with its name.
import type { ImageMetadata } from "astro";

interface Props {
  /** File name in src/assets/shots, without the extension (and without -dark). */
  name: string;
  alt: string;
  caption?: string;
  /** window: the desktop app's frame; phone: a handset; none: just the image with a border. */
  frame?: "window" | "phone" | "none";
  /** Text in the window's title bar. */
  title?: string;
  /** Light and dark side by side, cut on a diagonal. */
  split?: boolean;
  /** Labels for the two halves when split. */
  labels?: [string, string];
  /** Load it right away (above the fold). */
  eager?: boolean;
}

const shots = import.meta.glob<ImageMetadata>("../assets/shots/*.webp", { eager: true, import: "default" });
const {
  name,
  alt,
  caption,
  frame = "window",
  title = "Colonia",
  split = false,
  labels = ["Light", "Dark"],
  eager = false,
} = Astro.props;
// Spanish pages (/es/…) show the Spanish set (<name>.es.webp, <name>.es-dark.webp), panel and office in Spanish;
// a capture missing from it falls back to the English one.
const spanish = /(^|\/)es(\/|$)/.test(Astro.url.pathname);
const pick = (file: string) =>
  (spanish ? shots[`../assets/shots/${name}.es${file}.webp`] : undefined) ?? shots[`../assets/shots/${name}${file}.webp`];
const light = pick("");
const dark = pick("-dark");
// A clip of the same screen (src/assets/clips/<name>[.es][-dark].webm, with an .mp4 beside it) plays in a loop over
// the still, which stays as its poster and is all that shows to readers who ask for reduced motion. Not in split.
const clips = import.meta.glob<string>("../assets/clips/*.{webm,mp4}", { eager: true, query: "?url", import: "default" });
const clipOf = (file: string) => {
  const at = (lang: string, ext: string) => clips[`../assets/clips/${name}${lang}${file}.${ext}`];
  const lang = spanish ? ".es" : ""; // sin clip .es, la página en español se queda con el póster fijo (nunca un clip en inglés)
  const webm = at(lang, "webm");
  return webm ? { webm, mp4: at(lang, "mp4") } : undefined;
};
const poster = async (img: ImageMetadata | undefined) =>
  img ? (await getImage({ src: img, width: 1600, format: "webp", quality: 80 })).src : undefined;
const clipLight = !split && light ? clipOf("") : undefined;
const clipDark = !split && dark ? clipOf("-dark") : undefined;
const posterLight = clipLight ? await poster(light) : undefined;
const posterDark = clipDark ? await poster(dark) : undefined;
const widths = frame === "phone" ? [390, 780] : [800, 1200, 1600, 2400];
const sizes = frame === "phone" ? "(max-width: 600px) 80vw, 340px" : "(max-width: 900px) 100vw, 1100px";
const loading = eager ? "eager" : "lazy";
---

<figure class:list={["colonia-shot", `colonia-shot--${frame}`, { "colonia-shot--split": split && dark, "has-dark": dark }]}>
  <div class="colonia-shot__frame">
    {
      frame === "window" && (
        <div class="colonia-shot__bar" aria-hidden="true">
          <span class="dot r" />
          <span class="dot y" />
          <span class="dot g" />
          <span class="colonia-shot__title">{title}</span>
        </div>
      )
    }
    {
      light ? (
        <div class="colonia-shot__img">
          <Image class="is-light" src={light} alt={alt} widths={widths} sizes={sizes} quality={86} loading={loading} />
          {clipLight && (
            <video class="is-light colonia-shot__clip" autoplay muted loop playsinline preload="metadata" poster={posterLight} aria-label={alt}>
              <source src={clipLight.webm} type="video/webm" />
              {clipLight.mp4 && <source src={clipLight.mp4} type="video/mp4" />}
            </video>
          )}
          {clipDark && (
            <video class="is-dark colonia-shot__clip" autoplay muted loop playsinline preload="metadata" poster={posterDark} aria-label={alt}>
              <source src={clipDark.webm} type="video/webm" />
              {clipDark.mp4 && <source src={clipDark.mp4} type="video/mp4" />}
            </video>
          )}
          {dark && (
            <Image
              class="is-dark"
              src={dark}
              alt={split ? "" : alt}
              widths={widths}
              sizes={sizes}
              quality={86}
              loading={loading}
            />
          )}
          {split && dark && (
            <>
              <svg class="colonia-shot__cut" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
                <line x1="62" y1="0" x2="38" y2="100" />
              </svg>
              <span class="colonia-shot__tag colonia-shot__tag--l">{labels[0]}</span>
              <span class="colonia-shot__tag colonia-shot__tag--d">{labels[1]}</span>
            </>
          )}
        </div>
      ) : (
        <div class="colonia-shot__missing">
          <span>Screenshot</span>
          <code>{name}</code>
        </div>
      )
    }
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .colonia-shot {
    --bar: #eceef1;
    --bar-line: #dfe2e6;
    --bar-text: #6b7280;
    margin: 2rem 0;
  }
  :global(:root[data-theme="dark"]) .colonia-shot.has-dark:not(.colonia-shot--split) {
    --bar: #1a1c1f;
    --bar-line: #26292d;
    --bar-text: #8b939b;
  }
  .colonia-shot__frame {
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid var(--colonia-line-2);
    background: var(--bar);
    box-shadow:
      0 30px 70px -30px var(--colonia-shadow),
      0 0 0 6px var(--colonia-ring);
  }
  .colonia-shot__bar {
    display: flex;
    align-items: center;
    gap: 7px;
    height: 34px;
    padding: 0 12px;
    background: var(--bar);
    border-bottom: 1px solid var(--bar-line);
  }
  .colonia-shot--split .colonia-shot__bar {
    background: linear-gradient(105deg, #eceef1 0 52%, #1a1c1f 52% 100%);
    border-bottom-color: transparent;
  }
  .dot {
    width: 11px;
    height: 11px;
    border-radius: 50%;
  }
  .dot.r {
    background: #ff5f57;
  }
  .dot.y {
    background: #febc2e;
  }
  .dot.g {
    background: #28c840;
  }
  .colonia-shot__title {
    margin-left: 10px;
    font: 500 12px/1 var(--sl-font-mono);
    color: var(--bar-text);
  }
  .colonia-shot__img {
    position: relative;
  }
  .colonia-shot :global(img) {
    display: block;
    width: 100%;
    height: auto;
    margin: 0;
  }
  /* One capture, in the reader's theme. */
  .colonia-shot.has-dark:not(.colonia-shot--split) :global(.is-dark) {
    display: none;
  }
  :global(:root[data-theme="dark"]) .colonia-shot.has-dark:not(.colonia-shot--split) :global(.is-dark) {
    display: block;
  }
  :global(:root[data-theme="dark"]) .colonia-shot.has-dark:not(.colonia-shot--split) :global(.is-light) {
    display: none;
  }
  /* A clip lies over its still (which keeps the layout and is its poster); with reduced motion only the still shows. */
  .colonia-shot__clip {
    position: absolute;
    inset: 0;
    /* Starlight separa hermanos con margin-top: 1rem; desplazaba el vídeo 16 px sobre la fija. */
    margin: 0 !important;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media (prefers-reduced-motion: reduce) {
    .colonia-shot__clip {
      display: none !important;
    }
  }
  /* Both, cut on a diagonal: dark on the right. */
  .colonia-shot--split :global(.is-dark) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    clip-path: polygon(62% 0, 100% 0, 100% 100%, 38% 100%);
  }
  .colonia-shot__cut {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .colonia-shot__cut line {
    stroke: #3fb950;
    stroke-width: 2px;
    vector-effect: non-scaling-stroke;
    filter: drop-shadow(0 0 6px rgba(63, 185, 80, 0.8));
  }
  .colonia-shot__tag {
    position: absolute;
    bottom: 14px;
    padding: 5px 11px;
    border-radius: 999px;
    font: 600 11px/1 var(--sl-font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .colonia-shot__tag--l {
    left: 14px;
    background: #0b0d0f;
    color: #fff;
  }
  .colonia-shot__tag--d {
    right: 14px;
    background: #fff;
    color: #0b0d0f;
  }
  .colonia-shot--phone .colonia-shot__frame {
    max-width: 340px;
    margin: 0 auto;
    border-radius: 44px;
    border: 10px solid #121417;
    box-shadow:
      0 0 0 1px #2a2f35,
      0 40px 80px -30px var(--colonia-shadow);
  }
  .colonia-shot--none .colonia-shot__frame {
    box-shadow: 0 20px 50px -30px var(--colonia-shadow);
  }
  .colonia-shot__missing {
    display: grid;
    place-items: center;
    gap: 0.4rem;
    padding: 4rem 1rem;
    border: 2px dashed #c9ced4;
    color: #6b7280;
    font-size: 0.85rem;
  }
  figcaption {
    margin-top: 0.85rem;
    text-align: center;
    font-size: 0.85rem;
    color: var(--sl-color-gray-3);
  }
</style>
