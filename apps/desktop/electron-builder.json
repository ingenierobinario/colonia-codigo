{
  "appId": "com.ingenierobinario.colonia",
  "productName": "Colonia",
  "extraMetadata": {
    "name": "colonia",
    "homepage": "https://github.com/ingenierobinario/colonia"
  },
  "artifactName": "Colonia-${version}-${os}-${arch}.${ext}",
  "directories": {
    "output": "../../out",
    "buildResources": "assets"
  },
  "files": ["dist/**", "package.json", "!node_modules/**"],
  "extraResources": [
    {
      "from": ".stage/colonia",
      "to": "colonia",
      "filter": ["**/*"]
    },
    {
      "from": ".stage/colonia/node_modules",
      "to": "colonia/node_modules",
      "filter": ["**/*"]
    }
  ],
  "npmRebuild": false,
  "electronVersion": "44.5.1",
  "publish": null,
  "fileAssociations": [
    {
      "ext": "coloniaart",
      "name": "Colonia artifact",
      "description": "Colonia artifact",
      "role": "Viewer",
      "icon": "file-coloniaart",
      "mimeType": "application/x-colonia-artifact"
    },
    {
      "ext": "coloniaapp",
      "name": "Colonia app",
      "description": "Colonia app",
      "role": "Viewer",
      "icon": "file-coloniaapp",
      "mimeType": "application/x-colonia-app"
    },
    {
      "ext": "coloniaext",
      "name": "Colonia extension",
      "description": "Colonia extension",
      "role": "Viewer",
      "icon": "file-coloniaext",
      "mimeType": "application/x-colonia-extension"
    }
  ],
  "mac": {
    "target": ["dmg", "zip"],
    "icon": "assets/icon.icns",
    "category": "public.app-category.productivity",
    "identity": "-",
    "hardenedRuntime": false,
    "extendInfo": {
      "NSDesktopFolderUsageDescription": "Colonia and the agents you run in it work on the files of the projects you keep in your Desktop folder.",
      "NSDocumentsFolderUsageDescription": "Colonia and the agents you run in it work on the files of the projects you keep in your Documents folder.",
      "NSDownloadsFolderUsageDescription": "Colonia saves what you download from it, and its agents read the files you point them to, in your Downloads folder.",
      "NSRemovableVolumesUsageDescription": "Colonia and the agents you run in it work on the files of the projects you keep on this disk.",
      "NSNetworkVolumesUsageDescription": "Colonia and the agents you run in it work on the files of the projects you keep on this network disk.",
      "NSAppleEventsUsageDescription": "Colonia controls other apps only when you ask an agent to: sending a message, or working on this Mac for you.",
      "NSMicrophoneUsageDescription": "Colonia listens only while you dictate a message.",
      "NSCameraUsageDescription": "Colonia does not use the camera itself; a program one of your agents runs asked for it.",
      "NSLocalNetworkUsageDescription": "Colonia reaches your other devices and the services running on your network.",
      "UTExportedTypeDeclarations": [
        {
          "UTTypeIdentifier": "dev.colonia.artifact",
          "UTTypeDescription": "Colonia artifact",
          "UTTypeConformsTo": ["public.json", "public.data"],
          "UTTypeIconFile": "file-coloniaart.icns",
          "UTTypeTagSpecification": {
            "public.filename-extension": ["coloniaart"],
            "public.mime-type": ["application/x-colonia-artifact"]
          }
        },
        {
          "UTTypeIdentifier": "dev.colonia.app",
          "UTTypeDescription": "Colonia app",
          "UTTypeConformsTo": ["public.json", "public.data"],
          "UTTypeIconFile": "file-coloniaapp.icns",
          "UTTypeTagSpecification": {
            "public.filename-extension": ["coloniaapp"],
            "public.mime-type": ["application/x-colonia-app"]
          }
        },
        {
          "UTTypeIdentifier": "dev.colonia.extension",
          "UTTypeDescription": "Colonia extension",
          "UTTypeConformsTo": ["public.json", "public.data"],
          "UTTypeIconFile": "file-coloniaext.icns",
          "UTTypeTagSpecification": {
            "public.filename-extension": ["coloniaext"],
            "public.mime-type": ["application/x-colonia-extension"]
          }
        }
      ]
    }
  },
  "win": {
    "target": ["nsis", "zip"],
    "icon": "assets/icon.ico"
  },
  "nsis": {
    "oneClick": true,
    "perMachine": false,
    "runAfterFinish": true
  },
  "linux": {
    "target": ["AppImage", "zip", "deb", "rpm"],
    "icon": "assets/icons",
    "category": "Utility",
    "maintainer": "Colonia",
    "synopsis": "Your agents, your projects, one local core.",
    "executableName": "colonia"
  },
  "deb": {
    "depends": [
      "libgtk-3-0",
      "libnotify4",
      "libnss3",
      "libxss1",
      "libxtst6",
      "xdg-utils",
      "libatspi2.0-0",
      "libuuid1",
      "libsecret-1-0",
      "libasound2t64 | libasound2",
      "libgbm1"
    ]
  },
  "rpm": {
    "fpm": ["--directories", "/opt/Colonia"]
  }
}
